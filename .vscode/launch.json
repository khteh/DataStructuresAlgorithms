{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++ Launch (Console)",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "Presets: build linux-asan-debug",
            "postDebugTask": "",
            "program": "${workspaceFolder}/Debug/Console",
            "cwd": "${workspaceFolder}/build",
            "stopAtEntry": false,
            "externalConsole": false,
            "launchCompleteCommand": "exec-run",
            "environment": [
                {
                    // Both GDB and LeakSanitizer rely on ptrace, so the leak check has to be off while debugging.
                    "name": "ASAN_OPTIONS",
                    "value": "detect_leaks=0"
                }
            ],
            "logging": { "engineLogging": true, "trace": true, "traceResponse": true },
            "linux": {
              "MIMode": "gdb",
              "miDebuggerPath": "/usr/bin/gdb"
            },
            "osx": {
              "MIMode": "lldb"
            },
            "windows": {
              "MIMode": "gdb",
              "miDebuggerPath": "C:\\MinGw\\bin\\gdb.exe"
            },
            "args": [],
            "setupCommands": [
                {
                    "description": "Disable MI-async",
                    "text": "set mi-async off",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable auto-load for all paths. Considered a security risk. See link for details: https://sourceware.org/gdb/current/onlinedocs/gdb.html/Auto_002dloading-safe-path.html",
                    "text": "set auto-load safe-path /",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },                
                {
                    "description": "Do not display function arguments when printing a stack frame",
                    "text": "set print frame-arguments none",
                    "ignoreFailures": true
                }
            ]
        },          
        {
            "name": "C/C++: (gdb-oneapi) oneAPI CPU Launch & Break (Console)",
            "miDebuggerPath": "gdb-oneapi",
            "MIMode": "gdb",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "Presets: build linux-asan-debug",
            "postDebugTask": "",
            "stopAtEntry": false,
            "program": "${workspaceFolder}/Debug/Console",
            "cwd": "${workspaceFolder}/build",
            "args": [],
            "environment": [
                {
                    "name": "ZET_ENABLE_PROGRAM_DEBUGGING",
                    "value": "1"
                },
                {
                    "name": "IGC_EnableGTLocationDebugging",
                    "value": "1"
                },
                {
                    "name": "ONEAPI_DEVICE_SELECTOR",
                    "value": "*:cpu"
                },
                {
                    // Both GDB and LeakSanitizer rely on ptrace to monitor the process. Because Linux only allows a single process to attach via ptrace at one time, GDB blocks LeakSanitizer, causing it to crash immediately with a fatal error.
                    "name": "ASAN_OPTIONS",
                    "value": "detect_leaks=0"
                }
            ],
            "externalConsole": false,
            "setupCommands": [
                {
                    "description": "Disable MI-async",
                    "text": "set mi-async off",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable auto-load for all paths. Considered a security risk. See link for details: https://sourceware.org/gdb/current/onlinedocs/gdb.html/Auto_002dloading-safe-path.html",
                    "text": "set auto-load safe-path /",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },                
                {
                    "description": "Do not display function arguments when printing a stack frame",
                    "text": "set print frame-arguments none",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "C/C++: (gdb-oneapi) oneAPI CPU Launch & Break (Tests)",
            "miDebuggerPath": "gdb-oneapi",
            "MIMode": "gdb",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "Presets: build linux-asan-debug",
            "postDebugTask": "",
            "stopAtEntry": false,
            "program": "${workspaceFolder}/Debug/DataStructuresAlgorithms.Tests",
            "cwd": "${workspaceFolder}/build",
            "args": [],
            "environment": [
                {
                    "name": "ZET_ENABLE_PROGRAM_DEBUGGING",
                    "value": "1"
                },
                {
                    "name": "IGC_EnableGTLocationDebugging",
                    "value": "1"
                },
                {
                    "name": "ONEAPI_DEVICE_SELECTOR",
                    "value": "*:cpu"
                },
                {
                    // Both GDB and LeakSanitizer rely on ptrace to monitor the process. Because Linux only allows a single process to attach via ptrace at one time, GDB blocks LeakSanitizer, causing it to crash immediately with a fatal error.
                    "name": "ASAN_OPTIONS",
                    "value": "detect_leaks=0"
                }
            ],
            "externalConsole": false,
            "setupCommands": [
                {
                    "description": "Disable MI-async",
                    "text": "set mi-async off",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable auto-load for all paths. Considered a security risk. See link for details: https://sourceware.org/gdb/current/onlinedocs/gdb.html/Auto_002dloading-safe-path.html",
                    "text": "set auto-load safe-path /",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },                
                {
                    "description": "Do not display function arguments when printing a stack frame",
                    "text": "set print frame-arguments none",
                    "ignoreFailures": true
                }
            ]
        },
        {
            // Builds the linux-release preset (no sanitizers, so Release is linked with LTO) and runs it.
            "name": "Preset linux-release: Release + LTO, no sanitizers (Console)",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "Presets: build linux-release",
            "program": "${workspaceFolder}/build/linux-release/bin/Release/Console",
            "cwd": "${workspaceFolder}/build/linux-release",
            "args": [],
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Disable MI-async",
                    "text": "set mi-async off",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            // Builds the linux-release preset (no sanitizers, so Release is linked with LTO) and runs it.
            "name": "Preset linux-release: Release + LTO, no sanitizers (Tests)",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "Presets: build linux-release",
            "program": "${workspaceFolder}/build/linux-release/bin/Release/DataStructuresAlgorithms.Tests",
            "cwd": "${workspaceFolder}/build/linux-release",
            "args": [],
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Disable MI-async",
                    "text": "set mi-async off",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            // Not a debug session: after the linux-asan-debug build, runs every test through CTest in a terminal.
            "name": "Preset linux-asan-debug: run all tests with CTest",
            "type": "node-terminal",
            "request": "launch",
            "preLaunchTask": "Presets: build linux-asan-debug",
            "cwd": "${workspaceFolder}",
            "command": "ctest --preset linux-asan-debug"
        }
    ]
}
